{
  "name": "remote-target",
  "version": "0.6.1",
  "type": "module",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/remote-target.git"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "build_lib --verbose",
    "test": "bun test --max-concurrency 1 ./test",
    "test:container": "bun test test/container.test.ts test/container.integration.test.ts --max-concurrency 1",
    "test:integration": "bun test test/matrix.test.ts --max-concurrency 1",
    "test:package": "bun run scripts/testPackage.ts",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "dependencies": {
    "escapers": "0.1.0",
    "forward-slash-path": "0.3.0",
    "make-argv": "0.1.0",
    "optis": "0.3.0",
    "serialize-javascript": "7.1.2",
    "tinyhand": "0.2.0",
    "@babel/core": "8.0.6",
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@babel/plugin-transform-typescript": "8.0.5"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-jaid": "34.0.0",
    "fs-extra": "11.4.1",
    "make-ssh-keys": "1.0.1",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "zeug": "2.1.0",
    "@types/bun": "1.4.2",
    "@types/serialize-javascript": "5.0.4"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.11.0"
  },
  "sideEffects": false
}