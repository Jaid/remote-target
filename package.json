{
  "name": "remote-target",
  "version": "0.3.2",
  "type": "module",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/remote-target.git"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "audit": "bun audit",
    "build": "bun run scripts/build.ts",
    "lint": "bunx --bun eslint . --max-warnings 0",
    "prepack": "bun run build",
    "test": "bun test test/main.test.ts --max-concurrency 1",
    "test:integration": "bun test test/matrix.test.ts --max-concurrency 1",
    "test:package": "bun run scripts/testPackage.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "make-argv": "^0.1.0",
    "optis": "^0.1.0",
    "serialize-javascript": "^7.1.1",
    "tinyhand": "^0.2.0"
  },
  "devDependencies": {
    "@types/serialize-javascript": "^5.0.4",
    "bun-types": "^1.4.0",
    "eslint": "^10.9.1",
    "eslint-config-jaid": "^26.0.0",
    "make-ssh-keys": "^1.0.1",
    "tsconfig-jaid-bun": "^16.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zeug": "^2.1.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "packageManager": "bun@1.3.14",
  "sideEffects": false
}
